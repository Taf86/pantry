{
  "name": "pantry-api",
  "version": "0.0.1",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx --env-file=.env --watch src/main.ts",
    "build": "tsc -p tsconfig.build.json",
    "start": "node dist/main.js",
    "smoke": "node scripts/smoke-imports.mjs",
    "check-types": "tsc --noEmit",
    "lint": "eslint .",
    "test": "vitest run",
    "test:watch": "vitest",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "drizzle-kit migrate",
    "seed:admin": "tsx --env-file=.env scripts/seed-admin.ts",
    "vapid": "tsx scripts/generate-vapid.ts",
    "seed:admin:remote": "tsx --env-file=.env.remote scripts/seed-admin.ts",
    "format": "prettier --write --no-error-on-unmatched-pattern \"src/**/*.ts\" \"scripts/**/*.{ts,mjs}\" \"test/**/*.ts\"",
    "format:check": "prettier --check --no-error-on-unmatched-pattern \"src/**/*.ts\" \"scripts/**/*.{ts,mjs}\" \"test/**/*.ts\""
  },
  "dependencies": {
    "@pantry/shared": "workspace:*",
    "@trpc/server": "^11.18.0",
    "better-auth": "^1.7.0",
    "drizzle-orm": "1.0.0-rc.4",
    "fastify": "^5.12.0",
    "pino": "^10.3.1",
    "postgres": "^3.4.9",
    "web-push": "^3.6.7",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^22.10.7",
    "@types/web-push": "^3.6.4",
    "drizzle-kit": "1.0.0-rc.4",
    "eslint": "^10.8.1",
    "eslint-config-prettier": "^10.1.8",
    "pino-pretty": "^13.1.3",
    "prettier": "^3.9.6",
    "tsx": "^4.20.7",
    "typescript": "6.0.3",
    "typescript-eslint": "^8.67.0",
    "vitest": "^4.1.10"
  },
  "main": "./dist/main.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  }
}
