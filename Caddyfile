{
	admin off
	servers {
		trusted_proxies static private_ranges
	}
}

{$CADDY_SITE_ADDRESS::80} {
	log {
		output stdout
		format console
	}
	encode zstd gzip

	header {
		X-Content-Type-Options nosniff
		Referrer-Policy strict-origin-when-cross-origin
		X-Frame-Options DENY
		-Server
	}

	handle /api/* {
		reverse_proxy {$API_UPSTREAM:api:3000} {
			header_up X-Forwarded-For {client_ip}
		}
	}

	# Realtime handshakes and the WebSocket upgrade, on REALTIME_PATH rather
	# than the transport default. Without this the path falls through to the
	# SPA block below and the handshake is answered with index.html: fine in
	# dev, where Vite proxies it, broken in production.
	handle /ws/* {
		reverse_proxy {$API_UPSTREAM:api:3000} {
			header_up X-Forwarded-For {client_ip}
		}
	}

	handle /assets/* {
		root * /srv
		header Cache-Control "public, max-age=31536000, immutable"
		header /assets/*.woff2 Content-Type "font/woff2"
		file_server
	}

	handle /workbox-*.js {
		root * /srv
		header Cache-Control "public, max-age=31536000, immutable"
		file_server
	}

	handle {
		root * /srv
		header Cache-Control "no-cache"
		header /manifest.webmanifest Content-Type "application/manifest+json"
		try_files {path} /index.html
		file_server
	}

	handle_errors {
		header Cache-Control "no-store"
		respond "{err.status_code}" {err.status_code}
	}
}

:8080 {
	handle /healthz {
		respond "ok" 200
	}
	handle {
		respond 404
	}
}
