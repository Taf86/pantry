{
  "name": "pantry-api",
  "version": "0.0.1",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/main.ts",
    "build": "tsc -p tsconfig.build.json",
    "start": "node dist/main.js",
    "check-types": "tsc --noEmit",
    "lint": "eslint .",
    "test": "vitest run",
    "test:watch": "vitest",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "tsx src/scripts/migrate.ts",
    "seed:admin": "tsx src/scripts/seed-admin.ts",
    "format": "prettier --write \"src/**/*.ts\" \"test/**/*.ts\"",
    "format:check": "prettier --check \"src/**/*.ts\" \"test/**/*.ts\""
  },
  "dependencies": {
    "@trpc/server": "^11.7.1",
    "better-auth": "^1.4.1",
    "drizzle-orm": "^0.45.2",
    "fastify": "^5.8.5",
    "pantry-shared": "workspace:*",
    "pino": "^9.13.1",
    "postgres": "^3.4.7",
    "socket.io": "^4.8.1",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^22.10.7",
    "drizzle-kit": "^0.31.6",
    "eslint": "^10.8.1",
    "eslint-config-prettier": "^10.1.8",
    "pino-pretty": "^13.1.2",
    "prettier": "^3.9.6",
    "tsx": "^4.20.7",
    "typescript": "6.0.3",
    "typescript-eslint": "^8.67.0",
    "vitest": "^3.2.4"
  },
  "main": "./dist/main.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  }
}
