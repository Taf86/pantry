# Copia in /opt/pantry/.env sulla VPS, chmod 600, e riempi a mano.
# Nel repo pubblico va solo questo file, con valori fittizi.
#
# DATABASE_URL NON è qui: si compone nel codice da POSTGRES_PASSWORD.
# Se la password vivesse in due posti, la rotazione ne dimenticherebbe uno.

# openssl rand -base64 32
POSTGRES_PASSWORD=cambiami-password-del-database

# openssl rand -base64 32
BETTER_AUTH_SECRET=cambiami-segreto-delle-sessioni

# Dominio pubblico: è anche l'origine attendibile per cookie e WebSocket.
DOMAIN=pantry.dominio.it

# Repository GHCR da cui viene tirata l'immagine dell'API (utente/repo).
GITHUB_REPOSITORY=utente/pantry

# --- opzionali, con default sensati ---------------------------------------
# LOG_LEVEL=info
# PORT=3000
# DB_POOL_MAX=10

# Solo in sviluppo, quando Vite gira su un'altra porta.
# EXTRA_ORIGINS=http://localhost:5173

# --- Web Push (fase 7) -----------------------------------------------------
# npx web-push generate-vapid-keys
# VAPID_PUBLIC_KEY=
# VAPID_PRIVATE_KEY=
