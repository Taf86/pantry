# Questo file serve a due scopi.
#
#   Sviluppo  →  copialo in `.env` alla radice del repository. L'API lo carica
#                da sola (`loadLocalEnv`), quindi non serve esportare niente a
#                mano e funziona identico su bash e su PowerShell.
#   Produzione →  copialo in /opt/pantry/.env sulla VPS, chmod 600, riempi a
#                mano. Nel repo pubblico resta solo questo file, con valori
#                fittizi.
#
# DATABASE_URL NON è qui: si compone nel codice da POSTGRES_PASSWORD.
# Se la password vivesse in due posti, la rotazione ne dimenticherebbe uno.

# --- produzione ------------------------------------------------------------
# Genera i segreti con:  node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"

POSTGRES_PASSWORD=cambiami-password-del-database
BETTER_AUTH_SECRET=cambiami-segreto-delle-sessioni

# Dominio pubblico: è anche l'origine attendibile per cookie e WebSocket.
DOMAIN=pantry.dominio.it

# Repository GHCR da cui viene tirata l'immagine dell'API (utente/repo).
GITHUB_REPOSITORY=utente/pantry

# --- sviluppo locale -------------------------------------------------------
# Scommenta questo blocco (e commenta le due righe DOMAIN/POSTGRES_PASSWORD
# qui sopra) per lavorare in locale con `pnpm db:up`.
#
# POSTGRES_HOST=localhost
# POSTGRES_PASSWORD=pantry-dev
# BETTER_AUTH_SECRET=segreto-solo-per-lo-sviluppo-0123456789
#
# DOMAIN è l'origine che vede il *browser*, non la porta dell'API: è quella
# che conta per il cookie di sessione e per l'handshake WebSocket. In
# sviluppo il browser parla con Vite sulla 5173, che fa da proxy verso l'API
# sulla 3000.
# DOMAIN=localhost:5173

# --- opzionali, con default sensati ----------------------------------------
# LOG_LEVEL=info
# PORT=3000
# DB_POOL_MAX=10

# Origini attendibili extra, oltre a quella composta da DOMAIN.
# EXTRA_ORIGINS=http://127.0.0.1:5173

# --- Web Push (fase 7) -----------------------------------------------------
# npx web-push generate-vapid-keys
# VAPID_PUBLIC_KEY=
# VAPID_PRIVATE_KEY=
