{
  "name": "pantry",
  "private": true,
  "scripts": {
    "dev": "turbo run dev",
    "build": "turbo run build",
    "check-types": "turbo run check-types",
    "lint": "turbo run lint",
    "test": "turbo run test",
    "test:coverage": "turbo run test -- --coverage",
    "format": "turbo run format",
    "format:check": "turbo run format:check",
    "db:up": "docker compose -f docker-compose.dev.yml up -d --wait",
    "db:down": "docker compose -f docker-compose.dev.yml down -v",
    "db:logs": "docker compose -f docker-compose.dev.yml logs -f db",
    "db:migrate": "turbo run db:migrate",
    "seed:admin": "turbo run seed:admin --",
    "clean": "pnpm dlx rimraf --glob ./**/dist ./**/node_modules ./**/.turbo ./**/logs ./**/coverage ./**/test-report.html"
  },
  "devDependencies": {
    "turbo": "^2.10.9"
  },
  "engines": {
    "node": ">=22"
  },
  "packageManager": "pnpm@9.2.0"
}
